# ── 抓取原始产物：只保留结构化名录 roster_*.json，其余全部排除 ──
data/raw/*/*
!data/raw/*/roster_*.json
data/raw/*/roster_draft.json
data/raw/lab_pages/
data/raw/crossref/

# ── 大体积中间产物（可由 tools/ 重跑生成）──
# ── 关系网络构建的中间产物（可由 tools/ 重跑生成，且体积大）──
data/processed/_net_*.json
data/processed/_layout_*.json
data/processed/_mode_*.json
data/processed/_kappa_audit.json
data/processed/enriched_*.json
data/processed/mentor_db.json
data/processed/*_papers.json
data/processed/name_variants.json
# 含页面原文片段的中间产物（邮箱已在抽取阶段隐去，但原文一律不入库）
data/processed/timeline.json
data/processed/heuristics_all.json
data/processed/score_log.txt
data/processed/shortlist_2027.*
data/processed/shortlist_final.*

# ── 临时文件与系统文件 ──
*.tmp
*.log
*.pyc
__pycache__/
.venv/
.workbench-data/
node_modules/
Thumbs.db
desktop.ini
.DS_Store
# 本地运行产生的截图与一次性输出目录（界面走查、验收截图等）。
# 需要长期留存的图应放进 docs/ 或 reports/ 并显式命名。
/outputs/
# 凭据兜底：当前仓库没有这些文件，但没有规则就意味着"哪天有了也不会被挡住"。
.env
.env.*
*.pem
*.key
credentials*
secrets*

# ── 一次性侦察/调试产物（新增采集来源时常常留下，不应入库）──
# 采集脚本的临时页面、探查脚本与输出。放进 workbench/tests/fixtures/ 的正式快照
# 不受影响，因为那条路径以 workbench/ 开头。
tmp_*
/tmp/
workbench/tmp_*
_scratch_*
.scratch_*/
/scratch_*/
# 顶层下划线开头的临时脚本与输出（如 _dryrun.json、_rerun_dryrun.py）。正式脚本
# 一律放在 tools/ 或 workbench/tools/ 下，因此这条只影响临时产物。
/_*.py
/_*.json
/_*.txt
# 测试目录下只应放 _.py 测试与 fixtures/ 快照；dry-run 之类的一次性输出不应入库。
workbench/tests/*.txt
workbench/tests/*.json
/probe_*
workbench/probe_*

# 本地备份目录（不入库）
data/processed_bak_*/

data/processed/network.json
data/processed/cv_extracted.json
data/processed/cv_lineage.json
data/processed/cv_network.json
# 采集期临时探针（子代理/手工调试产物，不应入库）
/probe*.py
/.probe*/
/probe*.json
/probe*.txt
/_*.html
/_*.json
